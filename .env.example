# DCM ACCESS — variables de entorno
# Copiar a .env.local. Ninguna es obligatoria para arrancar en desarrollo.

# URL pública del sitio. Alimenta canónicas, hreflang, sitemap y Open Graph.
# OBLIGATORIA en producción: sin ella el SEO apunta a localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Fuente de datos: "demo" (memoria + semilla) o "supabase" (sin implementar todavía).
# Ver src/lib/data/supabase/index.ts para los pasos de conexión.
DCM_DATA_SOURCE=demo

# Contacto público. El correo por defecto del código ya es el oficial; esta
# variable solo hace falta para apuntar a otro en previsualizaciones.
NEXT_PUBLIC_DCM_EMAIL=dcmxaccess@gmail.com
NEXT_PUBLIC_DCM_PHONE=
