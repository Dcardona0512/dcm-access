# DCM ACCESS — variables de entorno
# Copiar a .env.local. Ninguna es obligatoria para arrancar en desarrollo.

# URL pública del sitio. Alimenta canónicas, hreflang, sitemap y Open Graph.
# OBLIGATORIA en producción: sin ella el SEO apunta a localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Fuente de datos: "demo" (memoria + semilla) o "supabase" (catálogo, leads,
# perfiles y partners de verdad). En producción va "supabase".
DCM_DATA_SOURCE=demo

# Contacto público. El correo por defecto del código ya es el oficial; esta
# variable solo hace falta para apuntar a otro en previsualizaciones.
NEXT_PUBLIC_DCM_EMAIL=dcmxaccess@gmail.com
NEXT_PUBLIC_DCM_PHONE=

# El WhatsApp de la plataforma, el mismo para vender y para preguntar por una
# ficha. Solo dígitos con indicativo, sin "+" ni espacios: es lo que exige
# wa.me. Sin valor, los botones caen al formulario de contacto en lugar de
# abrir un enlace roto.
#
# Es el número que atenderá el bot. Ojo: conectar un número a la API de
# WhatsApp lo saca de la aplicación del teléfono para siempre.
NEXT_PUBLIC_DCM_WHATSAPP=573222607394

# --- Supabase --------------------------------------------------------------
# La URL y la clave publicable son públicas por diseño: van al navegador y RLS
# es quien protege los datos.
NEXT_PUBLIC_SUPABASE_URL=https://unnnfyagowiohgpgbwgr.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_tyWHF99_wmalObK6HqVirQ_K5dThbmr

# La secreta se salta RLS por completo. SOLO servidor: si alguna vez aparece
# con prefijo NEXT_PUBLIC_, queda expuesta en el navegador.
SUPABASE_SECRET_KEY=

# --- Quién entra al panel --------------------------------------------------
# Ya NO hay variable de entorno que lo decida. El rol vive en la columna `role`
# de la tabla `profiles`, y se concede desde el panel. Las dos variables que
# había aquí —ADMIN_GATE y ADMIN_EMAILS— desaparecieron con la identidad real:
# una lista de correos en el entorno no es autorización, es una nota adhesiva.

# --- Entrada con Google ----------------------------------------------------
# No hay variable. El sitio le pregunta a Supabase qué proveedores están
# habilitados, así que el botón aparece solo el día que se conecte Google en
# Supabase → Auth → Providers, sin desplegar nada.

# --- Correo transaccional (Resend) -----------------------------------------
# Los enlaces de acceso y los avisos salen por aquí. Sin la clave, Supabase usa
# su servidor de cortesía, que corta el envío tras unos pocos mensajes por hora
# y deja a la gente sin poder entrar.
RESEND_API_KEY=
# Remitente. Mientras no haya un dominio verificado en Resend, su dominio de
# pruebas es el único que entrega.
EMAIL_FROM="DCM ACCESS <onboarding@resend.dev>"
